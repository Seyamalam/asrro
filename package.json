{
  "name": "asrro",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:scan": "concurrently --kill-others --names app,scan \"next dev\" \"react-scan init --yes --skip-install\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor . --no-telemetry --blocking error",
    "doctor:staged": "react-doctor . --staged --no-telemetry --blocking error --max-duration 90",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run doctor",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@tanstack/react-virtual": "^3.14.9",
    "better-auth": "1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-doctor": "^0.9.3",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
